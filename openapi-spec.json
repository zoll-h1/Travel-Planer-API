    "components": {
        "schemas": {
            "UpdateActivityRequest": {
                "required": [
                    "activityDate",
                    "cost",
                    "name",
                    "type"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "SIGHTSEEING",
                            "HOTEL",
                            "FLIGHT",
                            "RESTAURANT",
                            "TRANSPORT",
                            "OTHER"
                        ]
                    },
                    "activityDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "cost": {
                        "minimum": 0.0,
                        "exclusiveMinimum": false,
                        "type": "number"
                    },
                    "notes": {
                        "maxLength": 5000,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "ActivityResponse": {
                "type": "object",
                "properties": {
